# ===========================================================================
# Gostio -- configuration template
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored: never commit it and never attach it to a GitHub
# Release. This file is the single source of configuration -- none of these
# values may be hardcoded in source code or in appsettings.json.
# ===========================================================================

# --- Environment and API ---------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5000
# API address used by the client applications.
# Desktop (Windows):    http://localhost:5000
# Mobile (Android AVD): http://10.0.2.2:5000
API_BASE_URL=http://localhost:5000

# --- Database --------------------------------------------------------------
# DB_NAME must be the student index number, without the IB prefix.
DB_NAME=
DB_HOST=localhost
DB_PORT=1433
DB_SA_PASSWORD=
# Connection string read by the API. Password must match DB_SA_PASSWORD.
DATABASE_CONNECTION_STRING=Server=localhost,1433;Database=;User Id=sa;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True

# --- JWT -------------------------------------------------------------------
# Use a cryptographically random key, at least 32 bytes.
JWT_KEY=
JWT_ISSUER=Gostio.API
JWT_AUDIENCE=Gostio.Clients
JWT_EXPIRES_MINUTES=120

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_QUEUE_EMAIL=gostio.email
RABBITMQ_QUEUE_NOTIFICATIONS=gostio.notifications

# --- SMTP (used by the worker service) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gostio

# --- Stripe (sandbox) ------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Google Maps -----------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- CORS ------------------------------------------------------------------
# Explicit comma-separated origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- Seed ------------------------------------------------------------------
# Password assigned to the test accounts created when seeding the database.
SEED_DEFAULT_PASSWORD=
