# ===========================================================================
# Gostio -- configuration template
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored: never commit it and never attach it to a GitHub
# Release. This file is the single source of configuration -- none of these
# values may be hardcoded in source code or in appsettings.json.
# ===========================================================================

# --- Environment and API ---------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5000
# API address used by the client applications.
# Desktop (Windows):    http://localhost:5000
# Mobile (Android AVD): http://10.0.2.2:5000
API_BASE_URL=http://localhost:5000

# --- Database --------------------------------------------------------------
# DB_NAME must be the student index number, without the IB prefix.
# The connection string is composed from these values, so the database name
# and the password are each stated exactly once.
DB_NAME=
DB_HOST=localhost
# Host port for the SQL Server container. Change it if 1433 is already taken
# by a local SQL Server installation.
DB_PORT=1434
DB_USER=sa
DB_SA_PASSWORD=

# DATABASE_CONNECTION_STRING is optional and normally left unset. When it is
# set it overrides the values above; docker-compose uses it to point the
# containers at the database service name instead of localhost.
# DATABASE_CONNECTION_STRING=

# --- JWT -------------------------------------------------------------------
# Use a cryptographically random key, at least 32 bytes.
JWT_KEY=
JWT_ISSUER=Gostio.API
JWT_AUDIENCE=Gostio.Clients
JWT_EXPIRES_MINUTES=120

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_QUEUE_EMAIL=gostio.email
RABBITMQ_QUEUE_NOTIFICATIONS=gostio.notifications

# --- SMTP (used by the worker service) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gostio

# --- Stripe (sandbox) ------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Google Maps -----------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- CORS ------------------------------------------------------------------
# Explicit comma-separated origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- Worker ----------------------------------------------------------------
# How often the worker sweeps the reservations: holds whose deadline has passed
# are cancelled and bookings whose stay or term is over are completed. Between
# 5 and 3600 seconds.
WORKER_RESERVATION_SWEEP_SECONDS=60
# The most reservations one pass moves, shared by both of its halves.
WORKER_RESERVATION_SWEEP_BATCH=200
# How often the worker hands the refunds a cancellation owed to the payment
# processor and asks after the ones it has already sent. Between 5 and 3600
# seconds.
WORKER_REFUND_SWEEP_SECONDS=120
# The most refunds one pass sends or asks after.
WORKER_REFUND_SWEEP_BATCH=50

# --- Cache -----------------------------------------------------------------
# How long a reference table read from the database may be answered out of
# memory before it is fetched again. Every write to one of those tables drops
# what is held immediately, so this only bounds a staleness the process could
# not see: a read that raced a write, or a write another instance of the API
# made. Between 5 and 86400 seconds.
CACHE_LOOKUP_SECONDS=600

# --- Seed ------------------------------------------------------------------
# Password assigned to the test accounts created when seeding the database.
SEED_DEFAULT_PASSWORD=
