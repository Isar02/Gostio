<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <EmbeddedResource Include="Database\Seeding\Assets\*.jpg" />
    <EmbeddedResource Include="Database\Seeding\Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gostio.Model\Gostio.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The signed in user is read from IHttpContextAccessor inside this
         project rather than parsed out of a header by each caller, and that
         abstraction ships with ASP.NET Core. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Mapster" Version="10.0.11" />
    <!-- Design belongs here rather than in the API: this project owns the
         model, the migrations and the design-time context factory. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Stripe.net" Version="52.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
